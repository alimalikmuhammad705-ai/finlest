# King Agency Web Application Environment Variables
# Copy this file to .env.local for local development:
#   copy .env.example .env.local

# --- Application Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# --- Form Submission & Delivery ---
# Set to 'true' to log submissions to server console without requiring an email provider (Default for local dev)
FORM_DEV_LOG=true

# --- Email Delivery (Resend API) ---
# When you are ready to send live emails to your inbox, obtain a free API key at https://resend.com
# RESEND_API_KEY=re_your_api_key_here
# FORM_FROM_EMAIL=quotes@yourverifieddomain.com
FORM_TO_EMAIL=info@kingagency.world

# --- Rate Limiting & Security ---
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=600000
